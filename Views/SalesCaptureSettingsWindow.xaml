<Window x:Class="SMART_ERP.Views.SalesCaptureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Configuración de captura de ventas"
        Height="760"
        Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F8"
        Icon="/Resources/SmartERP.png"
        ShowInTaskbar="False">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- EMPRESAS FACTURADORAS -->
                <Border Background="White"
                        BorderBrush="#D8DFEA"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="Empresas facturadoras"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Empresas disponibles para registrar ventas."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="DgBillingCompanies"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Height="150"
                                  SelectionMode="Single">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Razón social"
                                                    Binding="{Binding LegalName}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="RTN"
                                                    Binding="{Binding TaxId}"
                                                    Width="150"/>

                                <DataGridCheckBoxColumn Header="Activa"
                                                        Binding="{Binding IsActive}"
                                                        Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">

                            <Button Content="Agregar"
                                    Click="BtnAddBillingCompany_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Editar"
                                    Click="BtnEditBillingCompany_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Activar / Desactivar"
                                    Click="BtnToggleBillingCompany_Click"
                                    Padding="14,7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ÁREAS EJECUTORAS -->
                <Border Background="White"
                        BorderBrush="#D8DFEA"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="Áreas ejecutoras"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Áreas disponibles para registrar ventas."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="DgOperationalAreas"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Height="150"
                                  SelectionMode="Single">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Área"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Descripción"
                                                    Binding="{Binding Description}"
                                                    Width="2*"/>

                                <DataGridCheckBoxColumn Header="Activa"
                                                        Binding="{Binding IsActive}"
                                                        Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">

                            <Button Content="Agregar"
                                    Click="BtnAddOperationalArea_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Editar"
                                    Click="BtnEditOperationalArea_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Activar / Desactivar"
                                    Click="BtnToggleOperationalArea_Click"
                                    Padding="14,7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- FORMAS DE PAGO -->
                <Border Background="White"
                        BorderBrush="#D8DFEA"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="Formas de pago"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Catálogo configurable. Desactivar no elimina registros históricos."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="DgPaymentMethods"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Height="150"
                                  SelectionMode="Single">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Forma de pago"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>

                                <DataGridCheckBoxColumn Header="Activa"
                                                        Binding="{Binding IsActive}"
                                                        Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">

                            <Button Content="Agregar"
                                    Click="BtnAddPaymentMethod_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Editar"
                                    Click="BtnEditPaymentMethod_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Activar / Desactivar"
                                    Click="BtnTogglePaymentMethod_Click"
                                    Padding="14,7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CONDICIONES DE VENTA -->
                <Border Background="White"
                        BorderBrush="#D8DFEA"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="Condiciones de venta"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Define contado y las condiciones de crédito con sus días."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="DgSalesConditions"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Height="150"
                                  SelectionMode="Single">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Condición"
                                                    Binding="{Binding Name}"
                                                    Width="2*"/>

                                <DataGridTextColumn Header="Días"
                                                    Binding="{Binding CreditDays}"
                                                    Width="100"/>

                                <DataGridCheckBoxColumn Header="Activa"
                                                        Binding="{Binding IsActive}"
                                                        Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">

                            <Button Content="Agregar"
                                    Click="BtnAddSalesCondition_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Editar"
                                    Click="BtnEditSalesCondition_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Activar / Desactivar"
                                    Click="BtnToggleSalesCondition_Click"
                                    Padding="14,7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CUENTAS RECEPTORAS -->
                <Border Background="White"
                        BorderBrush="#D8DFEA"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="Cuentas receptoras"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Cuenta o caja donde se recibe el pago."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="DgReceivingAccounts"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Height="150"
                                  SelectionMode="Single">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cuenta"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Descripción"
                                                    Binding="{Binding Description}"
                                                    Width="2*"/>

                                <DataGridCheckBoxColumn Header="Activa"
                                                        Binding="{Binding IsActive}"
                                                        Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,0">

                            <Button Content="Agregar"
                                    Click="BtnAddReceivingAccount_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Editar"
                                    Click="BtnEditReceivingAccount_Click"
                                    Padding="14,7"
                                    Margin="0,0,8,0"/>

                            <Button Content="Activar / Desactivar"
                                    Click="BtnToggleReceivingAccount_Click"
                                    Padding="14,7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- TIPOS FISCALES -->
                <Border Background="White"
                        BorderBrush="#D8DFEA"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="Tipos fiscales habilitados"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                        <WrapPanel>
                            <CheckBox x:Name="ChkTaxGravada"
                                      Content="Gravada ISV"
                                      Margin="0,0,16,8"/>

                            <CheckBox x:Name="ChkTaxMixta"
                                      Content="Mixta"
                                      Margin="0,0,16,8"/>

                            <CheckBox x:Name="ChkTaxExonerada"
                                      Content="Exonerada"
                                      Margin="0,0,16,8"/>

                            <CheckBox x:Name="ChkTaxExenta"
                                      Content="Exenta"
                                      Margin="0,0,16,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- COMISIONES -->
                <Border Background="White"
                        BorderBrush="#D8DFEA"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Comisión por defecto vendedor principal"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="TxtDefaultPrimaryCommission"
                                     Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Comisión por defecto vendedor secundario"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="TxtDefaultSecondaryCommission"
                                     Height="34"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ESTADOS -->
                <Border Background="White"
                        BorderBrush="#D8DFEA"
                        BorderThickness="1"
                        Padding="14"
                        Margin="0,0,0,10">

                    <StackPanel>
                        <TextBlock Text="Estados de factura"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Estados permitidos (separados por coma)"
                                   FontSize="12"
                                   Foreground="#6B7280"/>

                        <TextBox x:Name="TxtStatuses"
                                 Margin="0,6,0,0"
                                 Height="34"/>
                    </StackPanel>
                </Border>

                <!-- CONTROL -->
                <Border Background="White"
                        BorderBrush="#D8DFEA"
                        BorderThickness="1"
                        Padding="14">

                    <StackPanel>
                        <TextBlock Text="Control de captura"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,8"/>

                        <CheckBox x:Name="ChkRequireVoidReason"
                                  Content="Requerir motivo cuando la factura esté ANULADA"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Content="Cancelar"
                    Click="BtnCancel_Click"
                    Padding="14,7"
                    Margin="0,0,8,0"/>

            <Button Content="Guardar"
                    Click="BtnSave_Click"
                    Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>

