<Window x:Class="SMART_ERP.Views.ProductsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SMART_ERP.ViewModels"
        mc:Ignorable="d"
        Title="Inventario / Productos" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F5F5">
    
    <Window.DataContext>
        <viewmodels:ProductsViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" 
                   Text="Inventario / Productos" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#2196F3"
                   Margin="0,0,0,20"/>

        <!-- Formulario de Producto -->
        <Border Grid.Row="1" 
                Background="White" 
                Padding="20" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: Código, Nombre, Categoría -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Código:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="0" Text="{Binding Code}" IsReadOnly="True" Background="#F3F4F6" Padding="8" Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1" Text="Nombre *:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding Name}" Padding="8" Margin="10,0,10,0"/>

                    <TextBlock Grid.Column="2" Text="Categoría:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="2" Text="{Binding Category}" Padding="8" Margin="10,0,0,0"/>
                </Grid>

                <!-- Fila 2: Costo, Precios, Stock -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Costo:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="0" Text="{Binding Cost, StringFormat=N2}" Padding="8" Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1" Text="Precio 1:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding Price1, StringFormat=N2}" Padding="8" Margin="10,0,10,0"/>

                    <TextBlock Grid.Column="2" Text="Precio 2:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="2" Text="{Binding Price2, StringFormat=N2}" Padding="8" Margin="10,0,10,0"/>

                    <TextBlock Grid.Column="3" Text="Stock:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="3" Text="{Binding Stock, StringFormat=N2}" Padding="8" Margin="10,0,10,0"/>

                    <TextBlock Grid.Column="4" Text="Unidad:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="4" SelectedItem="{Binding Unit}" Padding="8" Margin="10,0,0,0">
                        <ComboBoxItem Content="UNIDAD"/>
                        <ComboBoxItem Content="CAJA"/>
                        <ComboBoxItem Content="PAQUETE"/>
                        <ComboBoxItem Content="DOCENA"/>
                        <ComboBoxItem Content="KILO"/>
                        <ComboBoxItem Content="LIBRA"/>
                        <ComboBoxItem Content="LITRO"/>
                        <ComboBoxItem Content="GALÓN"/>
                    </ComboBox>
                </Grid>

                <!-- Fila 3: Stock Mín/Max, Código Barras, Activo -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Stock Mín:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="0" Text="{Binding MinStock, StringFormat=N2}" Padding="8" Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1" Text="Stock Máx:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding MaxStock, StringFormat=N2}" Padding="8" Margin="10,0,10,0"/>

                    <TextBlock Grid.Column="2" Text="Código de Barras:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="2" Text="{Binding BarCode}" Padding="8" Margin="10,0,10,0"/>

                    <CheckBox Grid.Column="3" Content="Activo" IsChecked="{Binding IsActive}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Error Message -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding ErrorMessage}" 
                   Foreground="#D32F2F" 
                   FontSize="12"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Tabla de Productos -->
        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" 
                          ItemsSource="{Binding Products}" 
                          SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          RowBackground="White"
                          AlternatingRowBackground="#F9F9F9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Costo" Binding="{Binding Cost, StringFormat=L {0:N2}}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Precio 1" Binding="{Binding Price1, StringFormat=L {0:N2}}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat=N2}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="80" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="60" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Botones de Acción -->
                <StackPanel Grid.Row="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">
                    <Button Content="Nuevo" 
                            Command="{Binding CreateNewCommand}" 
                            Width="100" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#2196F3" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Guardar" 
                            Command="{Binding SaveCommand}" 
                            Width="100" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#4CAF50" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#45A049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Eliminar" 
                            Command="{Binding DeleteCommand}" 
                            Width="100" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#F44336" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D32F2F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Cancelar" 
                            Command="{Binding CancelCommand}" 
                            Width="100" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#FF9800" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F57C00"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Actualizar" 
                            Command="{Binding RefreshCommand}" 
                            Width="100" 
                            Height="35" 
                            Background="#2196F3" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
