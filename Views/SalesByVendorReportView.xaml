<Window x:Class="SMART_ERP.Views.SalesByVendorReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SMART_ERP.ViewModels"
        mc:Ignorable="d"
        Title="Ventas por Vendedor" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F5F5">
    
    <Window.DataContext>
        <viewmodels:SalesByVendorReportViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" 
                   Text="Ventas por Vendedor" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#2196F3"
                   Margin="0,0,0,20"/>

        <!-- Filtros de Fecha -->
        <Border Grid.Row="1" 
                Background="White" 
                Padding="20" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Fecha Inicio -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Fecha Inicio:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Padding="8" BorderThickness="1" BorderBrush="#BDBDBD"/>
                </StackPanel>

                <!-- Fecha Fin -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Fecha Fin:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Padding="8" BorderThickness="1" BorderBrush="#BDBDBD"/>
                </StackPanel>

                <!-- Botón Generar -->
                <Button Grid.Column="2" 
                        Content="Generar Reporte" 
                        Command="{Binding GenerateReportCommand}" 
                        Height="35" 
                        Width="120"
                        Background="#2196F3" 
                        Foreground="White" 
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5" 
                                               Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Resumen -->
        <Border Grid.Row="2" 
                Background="White" 
                Padding="20" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Ventas -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Ventas (Todos los Vendedores)" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalSalesAllVendors, StringFormat=L {0:N2}}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#4CAF50"/>
                </StackPanel>

                <!-- Total Cantidad -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Total Ventas (Cantidad)" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalSalesCount}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#2196F3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error Message -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding ErrorMessage}" 
                   Foreground="#D32F2F" 
                   FontSize="12"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Tabla de Datos -->
        <Border Grid.Row="4" 
                Background="White" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" 
                          ItemsSource="{Binding SalesReports}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          RowBackground="White"
                          AlternatingRowBackground="#F9F9F9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vendedor" 
                                            Binding="{Binding VendorName}" 
                                            Width="2*"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Código" 
                                            Binding="{Binding VendorCode}" 
                                            Width="100"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ventas" 
                                            Binding="{Binding SalesCount}" 
                                            Width="80"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total Ventas" 
                                            Binding="{Binding TotalSales, StringFormat=L {0:N2}}" 
                                            Width="120"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cantidad" 
                                            Binding="{Binding TotalQuantity, StringFormat=N2}" 
                                            Width="100"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Comisión" 
                                            Binding="{Binding TotalCommission, StringFormat=L {0:N2}}" 
                                            Width="100"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Promedio" 
                                            Binding="{Binding AverageSale, StringFormat=L {0:N2}}" 
                                            Width="100"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Primera Venta" 
                                            Binding="{Binding FirstSaleDate, StringFormat=dd/MM/yyyy}" 
                                            Width="100"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Última Venta" 
                                            Binding="{Binding LastSaleDate, StringFormat=dd/MM/yyyy}" 
                                            Width="100"
                                            IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Botones de Acción -->
                <StackPanel Grid.Row="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">
                    <Button Content="Exportar Excel" 
                            Command="{Binding ExportExcelCommand}" 
                            Width="120" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#4CAF50" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#45A049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Exportar PDF" 
                            Command="{Binding ExportPdfCommand}" 
                            Width="120" 
                            Height="35" 
                            Background="#F44336" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D32F2F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
