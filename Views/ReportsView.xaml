<UserControl x:Class="SMART_ERP.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Módulo de Reportes"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Actualizar"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"/>
                <Button Content="Limpiar Filtros"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Command="{Binding ClearFilterCommand}"/>
                <Button Content="Exportar Excel"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Command="{Binding ExportToExcelCommand}"/>
                <Button Content="Exportar CSV"
                        Padding="14,7"
                        Command="{Binding ExportToCsvCommand}"/>
            </StackPanel>
        </Grid>

        <!-- FILTROS -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FILA 1: Tipo de Reporte y Fechas -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TIPO DE REPORTE -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tipo de Reporte"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding ReportTypes}"
                                  SelectedItem="{Binding SelectedReportType}"
                                  Height="32"/>
                    </StackPanel>

                    <!-- FECHA DESDE -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha Desde"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <DatePicker SelectedDate="{Binding Filter.DateFrom}"
                                    Height="32"/>
                    </StackPanel>

                    <!-- FECHA HASTA -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fecha Hasta"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <DatePicker SelectedDate="{Binding Filter.DateTo}"
                                    Height="32"/>
                    </StackPanel>
                </Grid>

                <!-- FILA 2: Empresa, Área, Cliente -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- EMPRESA FACTURADORA -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Empresa Facturadora"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding BillingCompanies}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Filter.BillingCompanyId, Mode=TwoWay}"
                                  Height="32"/>
                    </StackPanel>

                    <!-- ÁREA OPERATIVA -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Área Operativa"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding OperationalAreas}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Filter.OperationalAreaId, Mode=TwoWay}"
                                  Height="32"/>
                    </StackPanel>

                    <!-- CLIENTE -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Cliente"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding Customers}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Filter.CustomerId, Mode=TwoWay}"
                                  Height="32"/>
                    </StackPanel>
                </Grid>

                <!-- FILA 3: Vendedor, Estado, Forma de Pago -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- VENDEDOR -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vendedor"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding Vendors}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Filter.VendorId, Mode=TwoWay}"
                                  Height="32"/>
                    </StackPanel>

                    <!-- ESTADO -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Estado"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding Filter.Status, Mode=TwoWay}"
                                  Height="32"/>
                    </StackPanel>

                    <!-- FORMA DE PAGO -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Forma de Pago"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding Filter.PaymentMethod, Mode=TwoWay}"
                                  Height="32"/>
                    </StackPanel>

                    <!-- BOTONES APLICAR Y LIMPIAR -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <Button Content="Aplicar Filtros"
                                Padding="14,7"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderBrush="#2563EB"
                                Cursor="Hand"
                                Command="{Binding ApplyFilterCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Limpiar"
                                Padding="12,7"
                                Background="#F1F5F9"
                                Foreground="#334155"
                                FontWeight="SemiBold"
                                BorderBrush="#CBD5E1"
                                Cursor="Hand"
                                Command="{Binding ClearFilterCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- CONTENIDO DEL REPORTE -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- MENSAJE DE ERROR -->
                <TextBlock x:Name="ErrorMessageBlock"
                           Grid.Row="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="#DC2626"
                           FontSize="12"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- REPORTES -->
                <TabControl Grid.Row="1" 
                           Background="Transparent"
                           BorderThickness="0"
                           SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                    <!-- REPORTE GENERAL -->
                    <TabItem Header="General">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TOTALES -->
                            <Border Grid.Row="0"
                                    Background="#F1F5F9"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cantidad de Ventas"
                                                   FontSize="11"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SalesSummaryTotals.SalesCount}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Total Vendido"
                                                   FontSize="11"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SalesSummaryTotals.TotalSold, StringFormat=L. {0:N2}}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Base Comisión"
                                                   FontSize="11"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SalesSummaryTotals.TotalCommissionBase, StringFormat=L. {0:N2}}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Total Comisiones"
                                                   FontSize="11"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SalesSummaryTotals.TotalCommissions, StringFormat=L. {0:N2}}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DATAGRID -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding SalesSummaryData}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      RowHeight="32">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding SaleId}" Width="50"/>
                                    <DataGridTextColumn Header="Factura" Binding="{Binding InvoiceNumber}" Width="100"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding SaleDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="2*"/>
                                    <DataGridTextColumn Header="Empresa" Binding="{Binding BillingCompanyName}" Width="150"/>
                                    <DataGridTextColumn Header="Área" Binding="{Binding OperationalAreaName}" Width="120"/>
                                    <DataGridTextColumn Header="Vendedor" Binding="{Binding PrimaryVendorName}" Width="150"/>
                                    <DataGridTextColumn Header="Forma Pago" Binding="{Binding PaymentMethod}" Width="100"/>
                                    <DataGridTextColumn Header="Días Crédito" Binding="{Binding CreditDays}" Width="90"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="80"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=L. {0:N2}}" Width="100"/>
                                    <DataGridTextColumn Header="Base Comisión" Binding="{Binding CommissionBase, StringFormat=L. {0:N2}}" Width="100"/>
                                    <DataGridTextColumn Header="%" Binding="{Binding CommissionPercentage, StringFormat={}{0:N2}%}" Width="60"/>
                                    <DataGridTextColumn Header="Comisión" Binding="{Binding CommissionAmount, StringFormat=L. {0:N2}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- REPORTE POR VENDEDOR -->
                    <TabItem Header="Por Vendedor">
                        <DataGrid ItemsSource="{Binding VendorReportData}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  RowHeight="32">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vendedor" Binding="{Binding VendorName}" Width="2*"/>
                                <DataGridTextColumn Header="Ventas" Binding="{Binding SalesCount}" Width="80"/>
                                <DataGridTextColumn Header="Total Vendido" Binding="{Binding TotalSold, StringFormat=L. {0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="Base Comisión" Binding="{Binding CommissionBase, StringFormat=L. {0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="Comisión Generada" Binding="{Binding CommissionGenerated, StringFormat=L. {0:N2}}" Width="130"/>
                                <DataGridTextColumn Header="Promedio Venta" Binding="{Binding AverageSale, StringFormat=L. {0:N2}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- REPORTE POR CLIENTE -->
                    <TabItem Header="Por Cliente">
                        <DataGrid ItemsSource="{Binding CustomerReportData}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  RowHeight="32">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="2*"/>
                                <DataGridTextColumn Header="Compras" Binding="{Binding PurchaseCount}" Width="80"/>
                                <DataGridTextColumn Header="Total Comprado" Binding="{Binding TotalPurchased, StringFormat=L. {0:N2}}" Width="130"/>
                                <DataGridTextColumn Header="Promedio Compra" Binding="{Binding AveragePurchase, StringFormat=L. {0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="Última Compra" Binding="{Binding LastPurchaseDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- REPORTE POR EMPRESA FACTURADORA -->
                    <TabItem Header="Por Empresa">
                        <DataGrid ItemsSource="{Binding BillingCompanyReportData}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  RowHeight="32">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Empresa" Binding="{Binding CompanyName}" Width="2*"/>
                                <DataGridTextColumn Header="Ventas" Binding="{Binding SalesCount}" Width="80"/>
                                <DataGridTextColumn Header="Total Vendido" Binding="{Binding TotalSold, StringFormat=L. {0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="Base Comisión" Binding="{Binding CommissionBase, StringFormat=L. {0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="Comisiones" Binding="{Binding Commissions, StringFormat=L. {0:N2}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- REPORTE POR ÁREA OPERATIVA -->
                    <TabItem Header="Por Área">
                        <DataGrid ItemsSource="{Binding OperationalAreaReportData}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  RowHeight="32">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Área" Binding="{Binding AreaName}" Width="2*"/>
                                <DataGridTextColumn Header="Ventas" Binding="{Binding SalesCount}" Width="80"/>
                                <DataGridTextColumn Header="Total Vendido" Binding="{Binding TotalSold, StringFormat=L. {0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="Comisiones" Binding="{Binding Commissions, StringFormat=L. {0:N2}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- REPORTE POR FORMA DE PAGO -->
                    <TabItem Header="Por Forma de Pago">
                        <DataGrid ItemsSource="{Binding PaymentMethodReportData}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  RowHeight="32">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Forma de Pago" Binding="{Binding PaymentMethod}" Width="2*"/>
                                <DataGridTextColumn Header="Operaciones" Binding="{Binding OperationCount}" Width="100"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=L. {0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="%" Binding="{Binding PercentageOfTotal, StringFormat={}{0:N2}%}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
