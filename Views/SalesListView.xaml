<UserControl x:Class="SMART_ERP.Views.SalesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Listado de ventas capturadas"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Actualizar"
                    Padding="14,7"
                    Click="BtnRefresh_Click"/>
        </Grid>

        <!-- FILTROS -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FILA 1 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>

                    <!-- EMPRESA -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Empresa facturadora"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="CmbBillingCompany"
                                  Height="32"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <!-- AREA -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Área ejecutora"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="CmbOperationalArea"
                                  Height="32"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <!-- CLIENTE -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Cliente"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="CmbCustomer"
                                  Height="32"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <!-- VENDEDOR -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Vendedor"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="CmbVendor"
                                  Height="32"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- FILA 2 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FECHA DESDE -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fecha desde"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <DatePicker x:Name="DpDateFrom"
                                    Height="32"
                                    SelectedDateChanged="DateFilter_Changed"/>
                    </StackPanel>

                    <!-- FECHA HASTA -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fecha hasta"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,5"/>

                        <DatePicker x:Name="DpDateTo"
                                    Height="32"
                                    SelectedDateChanged="DateFilter_Changed"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- LISTADO -->
        <DataGrid x:Name="DgSales"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Margin="0"
                  RowHeight="32">

            <DataGrid.Columns>

                <DataGridTextColumn Header="#"
                                    Binding="{Binding Id}"
                                    Width="50"/>

                <DataGridTextColumn Header="Factura"
                                    Binding="{Binding InvoiceNumber}"
                                    Width="120"/>

                <DataGridTextColumn Header="Fecha"
                                    Binding="{Binding SaleDate, StringFormat=dd/MM/yyyy}"
                                    Width="105"/>

                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Status}"
                                    Width="100"/>

                <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding CustomerName}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Empresa facturadora"
                                    Binding="{Binding BillingCompanyName}"
                                    Width="180"/>

                <DataGridTextColumn Header="Área ejecutora"
                                    Binding="{Binding OperationalAreaName}"
                                    Width="180"/>

                <DataGridTextColumn Header="Vendedor"
                                    Binding="{Binding PrimaryVendorName}"
                                    Width="160"/>

                <DataGridTextColumn Header="Forma pago"
                                    Binding="{Binding PaymentMethod}"
                                    Width="110"/>

                <DataGridTextColumn Header="Días crédito"
                                    Binding="{Binding CreditDays}"
                                    Width="95"/>

                <DataGridTextColumn Header="Total"
                                    Binding="{Binding Total, StringFormat=L. {0:N2}}"
                                    Width="120"/>

                <DataGridTextColumn Header="Comisión"
                                    Binding="{Binding TotalCommissionAmount, StringFormat=L. {0:N2}}"
                                    Width="120"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
