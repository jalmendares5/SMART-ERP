<Window x:Class="SMART_ERP.Views.CashTransactionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SMART_ERP.ViewModels"
        mc:Ignorable="d"
        Title="Tesorería / Caja" 
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F5F5">
    
    <Window.DataContext>
        <viewmodels:CashTransactionViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" 
                   Text="Tesorería / Caja" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#2196F3"
                   Margin="0,0,0,20"/>

        <!-- Saldo Actual -->
        <Border Grid.Row="1" 
                Background="White" 
                Padding="20" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Saldo Actual en Caja" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentBalance, StringFormat=L {0:N2}}" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="#4CAF50"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Última Actualización" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBlock Text="Actual" 
                               FontSize="16" 
                               Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error Message -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding ErrorMessage}" 
                   Foreground="#D32F2F" 
                   FontSize="12"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Formulario de Transacción -->
        <Border Grid.Row="3" 
                Background="White" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: Número, Fecha, Tipo -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Número:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="0" Text="{Binding TransactionNumber}" IsReadOnly="True" Background="#F3F4F6" Padding="8" Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1" Text="Fecha:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding TransactionDate}" Padding="8" Margin="10,0,10,0"/>

                    <TextBlock Grid.Column="2" Text="Tipo:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="2" SelectedItem="{Binding TransactionType}" Padding="8" Margin="10,0,0,0">
                        <ComboBoxItem Content="IN (Ingreso)"/>
                        <ComboBoxItem Content="OUT (Egreso)"/>
                    </ComboBox>
                </Grid>

                <!-- Fila 2: Categoría, Descripción, Monto -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Categoría:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="0" SelectedItem="{Binding Category}" Padding="8" Margin="0,0,10,0">
                        <ComboBoxItem Content="VENTAS"/>
                        <ComboBoxItem Content="PAGOS"/>
                        <ComboBoxItem Content="COMPRAS"/>
                        <ComboBoxItem Content="RETIRO"/>
                        <ComboBoxItem Content="DEPOSITO"/>
                        <ComboBoxItem Content="PAGO CLIENTE"/>
                        <ComboBoxItem Content="PAGO PROVEEDOR"/>
                        <ComboBoxItem Content="OTROS"/>
                    </ComboBox>

                    <TextBlock Grid.Column="1" Text="Descripción *:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding Description}" Padding="8" Margin="10,0,10,0"/>

                    <TextBlock Grid.Column="2" Text="Monto *:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="2" Text="{Binding Amount, StringFormat=L {0:N2}}" Padding="8" Margin="10,0,0,0"/>
                </Grid>

                <!-- Fila 3: Referencia -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Tipo Referencia:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="0" SelectedItem="{Binding ReferenceType}" Padding="8" Margin="0,0,10,0">
                        <ComboBoxItem Content="FACTURA"/>
                        <ComboBoxItem Content="COMPRA"/>
                        <ComboBoxItem Content="PAGO CLIENTE"/>
                        <ComboBoxItem Content="PAGO PROVEEDOR"/>
                        <ComboBoxItem Content="NINGUNA"/>
                    </ComboBox>

                    <TextBlock Grid.Column="1" Text="Número Referencia:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" Text="{Binding ReferenceNumber}" Padding="8" Margin="10,0,10,0"/>

                    <TextBlock Grid.Column="2" Text="Notas:" Margin="10,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="2" Text="{Binding Notes}" Padding="8" Margin="10,0,0,0"/>
                </Grid>

                <!-- Tabla de Transacciones -->
                <DataGrid Grid.Row="3" 
                          ItemsSource="{Binding Transactions}" 
                          SelectedItem="{Binding SelectedTransaction}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          RowBackground="White"
                          AlternatingRowBackground="#F9F9F9"
                          Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Número" Binding="{Binding TransactionNumber}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TransactionType}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat=L {0:N2}}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Referencia" Binding="{Binding ReferenceNumber}" Width="120" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Botones de Acción -->
                <StackPanel Grid.Row="4" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">
                    <Button Content="Nueva Transacción" 
                            Command="{Binding CreateNewCommand}" 
                            Width="140" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#2196F3" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Registrar" 
                            Command="{Binding SaveCommand}" 
                            Width="100" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#4CAF50" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#45A049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Actualizar" 
                            Command="{Binding RefreshCommand}" 
                            Width="100" 
                            Height="35" 
                            Background="#2196F3" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
