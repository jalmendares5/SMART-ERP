<UserControl x:Class="SMART_ERP.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100"
             Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MÓDULO DE CLIENTES" FontSize="24" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Height="36"
                Margin="0,0,0,15"
                BorderBrush="#AAB2BD"
                BorderThickness="1">
            <Grid>
                <TextBox x:Name="TxtBuscar"
                         FontSize="14"
                         Padding="10,6,40,6"
                         BorderThickness="0"
                         Background="Transparent"
                         ToolTip="Buscar por código, nombre, teléfono o correo"
                         TextChanged="TxtBuscar_TextChanged"/>

                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="#5F6B7A"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <DataGrid x:Name="DgClientes"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DgClientes_SelectionChanged"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="120"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Términos" Binding="{Binding PaymentTerms}" Width="120"/>
                <DataGridTextColumn Header="Días" Binding="{Binding CreditDays}" Width="90"/>
                <DataGridTextColumn Header="Límite" Binding="{Binding CreditLimit, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="140"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>



