<UserControl x:Class="SMART_ERP.Views.VendorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100"
             Background="White">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- TITULO -->
        <!-- ================================================= -->

        <TextBlock Grid.Row="0"
                   Text="VENDEDORES"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,15"/>

        <!-- ================================================= -->
        <!-- BARRA SUPERIOR -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Height="36"
                Margin="0,0,0,15"
                BorderBrush="#AAB2BD"
                BorderThickness="1">

            <Grid>
                <TextBox x:Name="TxtBuscar"
                         FontSize="14"
                         Padding="10,6,40,6"
                         BorderThickness="0"
                         Background="Transparent"
                         ToolTip="Buscar por código, nombre, teléfono o correo"
                         TextChanged="TxtBuscar_TextChanged"/>

                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="#5F6B7A"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- LISTA -->
        <!-- ================================================= -->

        <DataGrid x:Name="DgVendedores"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="DgVendedores_SelectionChanged"
                  MouseDoubleClick="DgVendedores_MouseDoubleClick"
                  Margin="0">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Código"
                                    Binding="{Binding Code}"
                                    Width="110"/>

                <DataGridTextColumn Header="Nombre"
                                    Binding="{Binding Name}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Comisión %"
                                    Binding="{Binding CommissionPercentage, StringFormat=N2}"
                                    Width="120"/>

                <DataGridTextColumn Header="Teléfono"
                                    Binding="{Binding Phone}"
                                    Width="140"/>

                <DataGridTextColumn Header="Correo"
                                    Binding="{Binding Email}"
                                    Width="2*"/>

                <DataGridCheckBoxColumn Header="Activo"
                                        Binding="{Binding IsActive}"
                                        Width="80"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>


