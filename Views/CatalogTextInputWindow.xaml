<Window x:Class="SMART_ERP.Views.CatalogTextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catálogo"
        Height="390"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EEF2F8"
        ShowInTaskbar="False">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"
                   Margin="0,0,0,14"/>

        <TextBlock x:Name="TxtLabel"
                   Grid.Row="1"
                   FontSize="12"
                   Foreground="#475569"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="TxtValue"
                 Grid.Row="2"
                 Height="36"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"/>

        <TextBlock x:Name="TxtSecondaryLabel"
                   Grid.Row="3"
                   FontSize="12"
                   Foreground="#475569"
                   Margin="0,0,0,6"
                   Visibility="Collapsed"/>

        <TextBox x:Name="TxtSecondaryValue"
                 Grid.Row="4"
                 Height="36"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 Visibility="Collapsed"/>

        <TextBlock x:Name="TxtTertiaryLabel"
                   Grid.Row="5"
                   FontSize="12"
                   Foreground="#475569"
                   Margin="0,0,0,6"
                   Visibility="Collapsed"/>

        <TextBox x:Name="TxtTertiaryValue"
                 Grid.Row="6"
                 Height="36"
                 VerticalContentAlignment="Center"
                 Visibility="Collapsed"/>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Cancelar"
                    Click="BtnCancel_Click"
                    Padding="14,7"
                    Margin="0,0,8,0"/>

            <Button Content="Guardar"
                    Click="BtnSave_Click"
                    Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
