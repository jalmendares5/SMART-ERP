<Window x:Class="SMART_ERP.Views.NewCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NUEVO CLIENTE"
        Width="830"
        Height="660"
        MinWidth="830"
        MinHeight="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#AAB2BD"/>
        </Style>
        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="132"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Border Background="White"
            BorderBrush="#B8C3D1"
            BorderThickness="1"
            Margin="8"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="NUEVO CLIENTE"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       Margin="0,0,0,12"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Código" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtCode" Style="{StaticResource FieldTextBox}"
                                     IsReadOnly="True" Background="#F3F4F6"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkActive" Grid.Column="1" Content="HABILITADO"
                                  IsChecked="True" VerticalAlignment="Bottom" Margin="14,0,0,7"
                                  FontSize="12" FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                            <TextBlock Text="Términos" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbTerms" Height="32" FontSize="13" SelectedIndex="0"
                                      SelectionChanged="CmbTerms_SelectionChanged">
                                <ComboBoxItem Content="CONTADO"/>
                                <ComboBoxItem Content="CREDITO"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="8,0,0,0">
                            <TextBlock Text="Días" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtCreditDays" Style="{StaticResource FieldTextBox}"
                                     Text="0" GotFocus="CreditDaysTextBox_GotFocus"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,5">
                        <TextBlock Text="Nombre *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource FieldTextBox}"
                                 TextChanged="UppercaseTextBox_TextChanged" BorderBrush="#2563EB"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtAddress" Style="{StaticResource FieldTextBox}" TextChanged="UppercaseTextBox_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtPhone" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="RTN" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtRtn" Style="{StaticResource FieldTextBox}" TextChanged="TxtRtn_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Correo" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtEmail" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Nombre del contacto" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtContactName" Style="{StaticResource FieldTextBox}" TextChanged="UppercaseTextBox_TextChanged"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="6,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,3,0">
                                <TextBlock Text="Ciudad" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCity" Style="{StaticResource FieldTextBox}" TextChanged="UppercaseTextBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                <TextBlock Text="País" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCountry" Style="{StaticResource FieldTextBox}" TextChanged="UppercaseTextBox_TextChanged"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Teléfono del contacto" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtContactPhone" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Departamento" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbDepartment" Height="32" FontSize="13" 
                                      SelectionChanged="CmbDepartment_SelectionChanged">
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Correo del contacto" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtContactEmail" Style="{StaticResource FieldTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Ciudad/Municipio" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbCity" Height="32" FontSize="13">
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="Crédito máximo" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtCreditLimit" Style="{StaticResource FieldTextBox}"
                                     Text="0" GotFocus="MoneyTextBox_GotFocus" LostFocus="MoneyTextBox_LostFocus"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="7" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Nota" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtNote" MinHeight="64" Padding="9,6" FontSize="13"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Precio de venta" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbPriceLevel" Height="32" SelectedIndex="0">
                                <ComboBoxItem Content="PRECIO DE VENTA 1"/>
                                <ComboBoxItem Content="PRECIO DE VENTA 2"/>
                                <ComboBoxItem Content="PRECIO DE VENTA 3"/>
                                <ComboBoxItem Content="PRECIO DE VENTA 4"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Grid>

            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="Limpiar" Style="{StaticResource FooterButton}"
                        HorizontalAlignment="Left" Click="BtnLimpiar_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource FooterButton}" Click="BtnCancelar_Click"/>
                    <Button Content="Guardar y Nuevo" Style="{StaticResource FooterButton}" Click="BtnGuardarNuevo_Click"/>
                    <Button Content="Guardar y Cerrar" Style="{StaticResource FooterButton}" Margin="0" Click="BtnGuardar_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

