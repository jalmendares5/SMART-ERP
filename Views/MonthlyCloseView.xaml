<Window x:Class="SMART_ERP.Views.MonthlyCloseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SMART_ERP.ViewModels"
        mc:Ignorable="d"
        Title="Cierre Mensual" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F5F5">
    
    <Window.DataContext>
        <viewmodels:MonthlyCloseViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" 
                   Text="Cierre Mensual" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#2196F3"
                   Margin="0,0,0,20"/>

        <!-- Selección de Período -->
        <Border Grid.Row="1" 
                Background="White" 
                Padding="20" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Año -->
                <TextBlock Grid.Column="0" 
                           Text="Año:" 
                           Margin="0,0,0,5" 
                           FontWeight="SemiBold"/>
                <ComboBox Grid.Column="0" 
                          SelectedItem="{Binding SelectedYear}" 
                          Padding="8" 
                          Margin="0,0,10,10"
                          BorderThickness="1" 
                          BorderBrush="#BDBDBD">
                    <ComboBoxItem Content="2024"/>
                    <ComboBoxItem Content="2025"/>
                    <ComboBoxItem Content="2026"/>
                    <ComboBoxItem Content="2027"/>
                    <ComboBoxItem Content="2028"/>
                </ComboBox>

                <!-- Mes -->
                <TextBlock Grid.Column="1" 
                           Text="Mes:" 
                           Margin="0,0,0,5" 
                           FontWeight="SemiBold"/>
                <ComboBox Grid.Column="1" 
                          SelectedItem="{Binding SelectedMonth}" 
                          Padding="8" 
                          Margin="0,0,10,10"
                          BorderThickness="1" 
                          BorderBrush="#BDBDBD">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                </ComboBox>

                <!-- Botón Calcular -->
                <Button Grid.Column="2" 
                        Content="Calcular Totales" 
                        Command="{Binding CalculateCommand}" 
                        Height="35" 
                        Margin="0,0,0,10"
                        Background="#2196F3" 
                        Foreground="White" 
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                               CornerRadius="5" 
                                               Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1976D2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Totales del Período -->
        <Border Grid.Row="2" 
                Background="White" 
                Padding="20" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Ventas -->
                <TextBlock Grid.Column="0" 
                           Text="Total Ventas:" 
                           Margin="0,0,0,5" 
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Column="0" 
                           Text="{Binding TotalSales, StringFormat=C}" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#4CAF50"
                           Margin="0,0,10,10"/>

                <!-- Total Cantidad -->
                <TextBlock Grid.Column="1" 
                           Text="Total Cantidad:" 
                           Margin="0,0,0,5" 
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding TotalQuantity, StringFormat=N2}" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#2196F3"
                           Margin="0,0,10,10"/>

                <!-- Total Comisión -->
                <TextBlock Grid.Column="2" 
                           Text="Total Comisión:" 
                           Margin="0,0,0,5" 
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" 
                           Text="{Binding TotalCommission, StringFormat=C}" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#FF9800"
                           Margin="0,0,0,10"/>
            </Grid>
        </Border>

        <!-- Error Message -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding ErrorMessage}" 
                   Foreground="#D32F2F" 
                   FontSize="12"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Lista de Cierres -->
        <Border Grid.Row="4" 
                Background="White" 
                CornerRadius="10" 
                BorderThickness="1" 
                BorderBrush="#E0E0E0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" 
                          ItemsSource="{Binding MonthlyCloses}" 
                          SelectedItem="{Binding SelectedClose}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0"
                          RowBackground="White"
                          AlternatingRowBackground="#F9F9F9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" 
                                            Binding="{Binding Id}" 
                                            Width="50"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Período" 
                                            Binding="{Binding Year, StringFormat={}{0}/}" 
                                            Width="80"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mes" 
                                            Binding="{Binding Month}" 
                                            Width="60"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ventas" 
                                            Binding="{Binding TotalSales, StringFormat=C}" 
                                            Width="100"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cantidad" 
                                            Binding="{Binding TotalQuantity, StringFormat=N2}" 
                                            Width="100"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Comisión" 
                                            Binding="{Binding TotalCommission, StringFormat=C}" 
                                            Width="100"
                                            IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Cerrado" 
                                                Binding="{Binding IsClosed}" 
                                                Width="70"
                                                IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cerrado Por" 
                                            Binding="{Binding ClosedBy}" 
                                            Width="120"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Fecha Cierre" 
                                            Binding="{Binding ClosedAt, StringFormat=dd/MM/yyyy HH:mm}" 
                                            Width="120"
                                            IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Botones de Acción -->
                <StackPanel Grid.Row="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">
                    <Button Content="Cerrar Período" 
                            Command="{Binding ClosePeriodCommand}" 
                            Width="120" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#4CAF50" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#45A049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Abrir Período" 
                            Command="{Binding OpenPeriodCommand}" 
                            Width="120" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#FF9800" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F57C00"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Eliminar" 
                            Command="{Binding DeleteCommand}" 
                            Width="100" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#F44336" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D32F2F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Actualizar" 
                            Command="{Binding RefreshCommand}" 
                            Width="100" 
                            Height="35" 
                            Background="#2196F3" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="5" 
                                                   Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
