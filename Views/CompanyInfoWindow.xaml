<Window x:Class="SMART_ERP.Views.CompanyInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Información de la Empresa"
        Height="620"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#DCE3F1"
        Icon="/Resources/SmartERP.png" ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#C9D3E5" BorderBrush="#AEBBD2" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Nombre de la empresa" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCompanyName" Height="32" Margin="0,0,0,8"/>

                    <TextBlock Text="Eslogan" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSlogan" Height="32" Margin="0,0,0,8"/>

                    <TextBlock Text="RTN" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRtn" Height="32" Margin="0,0,0,8"/>

                    <TextBlock Text="Teléfono" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPhone" Height="32" Margin="0,0,0,8"/>

                    <TextBlock Text="Correo" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmail" Height="32" Margin="0,0,0,8"/>

                    <TextBlock Text="Dirección" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAddress" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#D3DBEA" BorderBrush="#AEBBD2" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Logo de la empresa" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Border Background="White" BorderBrush="#B9C5DA" BorderThickness="1" Padding="6">
                            <Image x:Name="ImgLogo" Height="220" Stretch="Uniform"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="Seleccionar imagen" Click="BtnSelectImage_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Quitar" Click="BtnClearImage_Click" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" Click="BtnCancel_Click" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="Guardar y cerrar" Click="BtnSave_Click" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
