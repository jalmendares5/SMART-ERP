<UserControl x:Class="SMART_ERP.Views.RegisterSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SMART_ERP.Converters"
             mc:Ignorable="d"
             d:DesignHeight="780"
             d:DesignWidth="1200"
             Background="#F5F7FA">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding GuardarCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisConverter"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

            <Grid Margin="12">
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Margin="0" Style="{StaticResource CardBorder}" Padding="0" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="20,16,20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#2563EB" Width="44" Height="44" CornerRadius="22">
                                    <TextBlock Text="🛒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Registrar venta" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Registra la información de la venta" FontSize="12" Foreground="#6B7280"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="&#x2699; Configuración"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="140"
                                    Height="38"
                                    Click="OpenSalesSettings_Click"/>
                        </Grid>

                        <Border Grid.Row="0" Height="1" Background="#F3F4F6" VerticalAlignment="Bottom"/>

                        <StackPanel Grid.Row="1" Margin="20,18,20,18">
                            <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12"/>
                            </Border>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="# Factura" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fecha" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding SaleDate}" FontSize="13" BorderBrush="#D1D5DB" BorderThickness="1" Height="38" Padding="8,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Estado de factura" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding Status}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Tipo fiscal" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding AvailableInvoiceTaxTypes}" SelectedItem="{Binding InvoiceTaxType}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><DockPanel Margin="0,0,0,6"><TextBlock Text="Cliente" Style="{StaticResource FieldLabel}" Margin="0"/><TextBlock Text="+ Nuevo cliente" Foreground="#2563EB" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/></DockPanel><ComboBox Style="{StaticResource ModernComboBox}" IsEditable="True" ItemsSource="{Binding FilteredCustomers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Empresa facturadora" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding BillingCompanies}" SelectedItem="{Binding SelectedBillingCompany}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBox}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Área ejecutora" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding OperationalAreas}" SelectedItem="{Binding SelectedOperationalArea}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBox}"/></StackPanel></Grid>

                            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Condición actual del cliente:" Foreground="#6B7280" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedCustomer.PaymentTerms}" Foreground="#2563EB" FontWeight="Bold" FontSize="12" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#E5E7EB" Width="1" Margin="10,0"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="Días de crédito:" Foreground="#6B7280" FontSize="12"/>
                                        <TextBlock Text="{Binding CreditDays}" Foreground="#111827" FontWeight="SemiBold" FontSize="12" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="3" Background="#E5E7EB" Width="1" Margin="10,0"/>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <TextBlock Text="Límite de crédito:" Foreground="#6B7280" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedCustomer.CreditLimit, StringFormat={}{0:N2}}" Foreground="#111827" FontWeight="SemiBold" FontSize="12" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="5" Background="#E5E7EB" Width="1" Margin="10,0"/>

                                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                                        <TextBlock Text="Saldo pendiente:" Foreground="#6B7280" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedCustomer.PendingBalance, StringFormat={}{0:N2}}" Foreground="#111827" FontWeight="SemiBold" FontSize="12" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            
<StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center"><TextBlock Text="Vendedores" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/><CheckBox IsChecked="{Binding IsSpecialSale}" Margin="14,0,0,0" VerticalAlignment="Center"/><TextBlock Text="Venta especial (2 vendedores)" Margin="6,0,0,0" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/></StackPanel>

                            <Grid Margin="0,0,0,14">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="1*"/>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Margin="0,0,10,0">
        <TextBlock Text="Vendedor principal" Style="{StaticResource FieldLabel}"/>
        <ComboBox Style="{StaticResource ModernComboBox}" IsEditable="True" ItemsSource="{Binding FilteredPrimaryVendors}" SelectedItem="{Binding SelectedPrimaryVendor}" DisplayMemberPath="Name" Text="{Binding PrimaryVendorSearchText, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>

    <StackPanel Grid.Column="1" Margin="0,0,10,0">
        <TextBlock Text="% Comisión vendedor principal" Style="{StaticResource FieldLabel}"/>
        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding PrimaryCommissionPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" GotFocus="NumericSelectAll_GotFocus"/>
    </StackPanel>

    <StackPanel Grid.Column="2" Margin="0,0,10,0" Visibility="{Binding IsSpecialSale, Converter={StaticResource BoolToVisConverter}}">
        <TextBlock Text="Vendedor secundario" Style="{StaticResource FieldLabel}"/>
        <ComboBox Style="{StaticResource ModernComboBox}" IsEditable="True" IsEnabled="{Binding IsSecondaryVendorEnabled}" ItemsSource="{Binding FilteredSecondaryVendors}" SelectedItem="{Binding SelectedSecondaryVendor}" DisplayMemberPath="Name" Text="{Binding SecondaryVendorSearchText, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>

    <StackPanel Grid.Column="3" Visibility="{Binding IsSpecialSale, Converter={StaticResource BoolToVisConverter}}">
        <TextBlock Text="% Comisión vendedor secundario" Style="{StaticResource FieldLabel}"/>
        <TextBox Style="{StaticResource ModernTextBox}" IsEnabled="{Binding IsSecondaryVendorEnabled}" Text="{Binding SecondaryCommissionPercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" GotFocus="NumericSelectAll_GotFocus"/>
    </StackPanel>
</Grid><StackPanel Margin="0,0,0,18">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Total de la venta" Style="{StaticResource FieldLabel}"/>
                                        <Grid><TextBox Style="{StaticResource ModernTextBox}" Padding="28,6,8,6" Text="{Binding Total, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" GotFocus="MoneyTextBox_GotFocus" LostFocus="MoneyTextBox_LostFocus"/><TextBlock Text="L." Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#6B7280" FontWeight="SemiBold" IsHitTestVisible="False"/></Grid></StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Visibility="{Binding ShowExoneratedAmount, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Total exonerado" Style="{StaticResource FieldLabel}"/>
                                        <Grid><TextBox Style="{StaticResource ModernTextBox}" Padding="28,6,8,6" Text="{Binding ExoneratedAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" GotFocus="MoneyTextBox_GotFocus" LostFocus="MoneyTextBox_LostFocus"/><TextBlock Text="L." Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#6B7280" FontWeight="SemiBold" IsHitTestVisible="False"/></Grid></StackPanel>

                                    <StackPanel Grid.Column="4"
                                                Visibility="{Binding ShowExemptAmount, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Total exento" Style="{StaticResource FieldLabel}"/>
                                        <Grid><TextBox Style="{StaticResource ModernTextBox}" Padding="28,6,8,6" Text="{Binding ExemptAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" GotFocus="MoneyTextBox_GotFocus" LostFocus="MoneyTextBox_LostFocus"/><TextBlock Text="L." Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#6B7280" FontWeight="SemiBold" IsHitTestVisible="False"/></Grid></StackPanel>
                                </Grid>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Condiciones de venta" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
    <TextBlock Text="Condición de venta" Style="{StaticResource FieldLabel}"/>
    <ComboBox Style="{StaticResource ModernComboBox}"
              ItemsSource="{Binding AvailableSalesConditions}"
              SelectedItem="{Binding SelectedSalesCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              DisplayMemberPath="Name"
              IsTextSearchEnabled="True"/>
</StackPanel>

<StackPanel Grid.Column="2">
    <TextBlock Text="Forma de pago" Style="{StaticResource FieldLabel}"/>
    <ComboBox Style="{StaticResource ModernComboBox}"
              ItemsSource="{Binding AvailablePaymentMethods}"
              SelectedItem="{Binding PaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsTextSearchEnabled="True"
              IsEnabled="{Binding IsPaymentMethodEnabled}"/>
</StackPanel>

<StackPanel Grid.Column="4">
    <TextBlock Text="Cuenta receptora" Style="{StaticResource FieldLabel}"/>
    <ComboBox Style="{StaticResource ModernComboBox}"
              ItemsSource="{Binding AvailableReceivingAccounts}"
              SelectedItem="{Binding SelectedReceivingAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              DisplayMemberPath="Name"
              IsTextSearchEnabled="True"
              IsEnabled="{Binding IsReceivingAccountEnabled}"/>
</StackPanel>

                                            
                                        </Grid>

                                        <TextBlock Text="Observaciones (opcional)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="74"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 BorderBrush="#D1D5DB"
                                                 BorderThickness="1"
                                                 Padding="10,8"/>
                                        <TextBlock Text="{Binding NotesRemaining}" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Resumen de la venta" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,12"/>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Total gravado con ISV"
                                                       Grid.Row="0"
                                                       Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding Total, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="0"
                                                       Grid.Column="1"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="Base gravada sin ISV"
                                                       Grid.Row="1"
                                                       Foreground="#6B7280"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding TaxableBase, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="1"
                                                       Grid.Column="1"
                                                       Margin="0,3,0,0"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="ISV 15%"
                                                       Grid.Row="2"
                                                       Foreground="#6B7280"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding IsvAmount, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="2"
                                                       Grid.Column="1"
                                                       Margin="0,3,0,0"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="Total exonerado"
                                                       Grid.Row="3"
                                                       Foreground="#6B7280"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ExoneratedAmount, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="3"
                                                       Grid.Column="1"
                                                       Margin="0,3,0,0"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="Total exento"
                                                       Grid.Row="4"
                                                       Foreground="#6B7280"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ExemptAmount, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="4"
                                                       Grid.Column="1"
                                                       Margin="0,3,0,0"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="TOTAL FACTURA"
                                                       Grid.Row="5"
                                                       Foreground="#111827"
                                                       FontWeight="Bold"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding InvoiceTotal, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="5"
                                                       Grid.Column="1"
                                                       Foreground="#2563EB"
                                                       FontWeight="Bold"
                                                       Margin="0,4,0,0"/>

                                            <TextBlock Text="BASE PARA COMISIÓN"
                                                       Grid.Row="6"
                                                       Foreground="#6B7280"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding CommissionBase, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="6"
                                                       Grid.Column="1"
                                                       Margin="0,4,0,0"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="% Total de comisión"
                                                       Grid.Row="7"
                                                       Foreground="#6B7280"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding TotalCommissionPercentage, StringFormat={}{0:N2}%}"
                                                       Grid.Row="7"
                                                       Grid.Column="1"
                                                       Margin="0,3,0,0"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="Comisión vendedor principal"
                                                       Grid.Row="8"
                                                       Foreground="#6B7280"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding PrimaryCommissionAmount, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="8"
                                                       Grid.Column="1"
                                                       Margin="0,3,0,0"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="Comisión vendedor secundario"
                                                       Grid.Row="9"
                                                       Foreground="#6B7280"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding IsSpecialSale, Converter={StaticResource BoolToVisConverter}}"/>
                                            <TextBlock Text="{Binding SecondaryCommissionAmount, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="9"
                                                       Grid.Column="1"
                                                       Margin="0,3,0,0"
                                                       FontWeight="SemiBold"
                                                       Visibility="{Binding IsSpecialSale, Converter={StaticResource BoolToVisConverter}}"/>

                                            <TextBlock Text="COMISIÓN TOTAL"
                                                       Grid.Row="10"
                                                       Foreground="#111827"
                                                       FontWeight="Bold"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding TotalCommissionAmount, StringFormat='L. {0:N2}'}"
                                                       Grid.Row="10"
                                                       Grid.Column="1"
                                                       Foreground="#2563EB"
                                                       FontWeight="Bold"
                                                       Margin="0,5,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        
                    </Grid>
        </Border>
    </ScrollViewer>

<Border Grid.Row="1" Height="1" Background="#F3F4F6" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,10" Background="White">
                            <Button Content="&#x2715; Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource SecondaryButton}" MinWidth="120" Height="40" Margin="0,0,10,0"/>
                            <Button Content="&#x1F4BE; Guardar venta (F5)" Command="{Binding GuardarCommand}" Style="{StaticResource PrimaryButton}" MinWidth="170" Height="40"/>
                        </StackPanel>

</Grid>
</UserControl>



























