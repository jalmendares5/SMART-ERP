<UserControl x:Class="SMART_ERP.Views.CompanyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITULO -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock x:Name="TxtTitle"
                       Text="Nueva empresa"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"/>

            <TextBlock Text="Configure los datos de conexión de la empresa."
                       Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="#64748B"/>

        </StackPanel>


        <!-- FORMULARIO -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid MaxWidth="700"
                  HorizontalAlignment="Left">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- EMPRESA -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Nombre de empresa"
                           VerticalAlignment="Center"
                           Margin="0,0,15,12"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="TxtCompanyName"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="34"
                         Margin="0,0,0,12"
                         Padding="8,5"/>


                <!-- TIPO -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Tipo de conexión"
                           VerticalAlignment="Center"
                           Margin="0,0,15,12"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="CmbConnectionType"
                          Grid.Row="1"
                          Grid.Column="1"
                          Height="34"
                          Margin="0,0,0,12"
                          SelectionChanged="CmbConnectionType_SelectionChanged">

                    <ComboBoxItem Content="LOCAL"
                                  Tag="LOCAL"/>

                    <ComboBoxItem Content="LAN"
                                  Tag="LAN"/>

                    <ComboBoxItem Content="REMOTA"
                                  Tag="REMOTA"/>

                </ComboBox>


                <!-- SERVIDOR -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Servidor / IP"
                           VerticalAlignment="Center"
                           Margin="0,0,15,12"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="TxtServer"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="34"
                         Margin="0,0,0,12"
                         Padding="8,5"/>


                <!-- PUERTO -->

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Puerto"
                           VerticalAlignment="Center"
                           Margin="0,0,15,12"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="TxtPort"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="34"
                         Margin="0,0,0,12"
                         Padding="8,5"/>


                <!-- BASE -->

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Base de datos"
                           VerticalAlignment="Center"
                           Margin="0,0,15,12"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="TxtDatabase"
                         Grid.Row="4"
                         Grid.Column="1"
                         Height="34"
                         Margin="0,0,0,12"
                         Padding="8,5"/>


                <!-- USUARIO -->

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Usuario"
                           VerticalAlignment="Center"
                           Margin="0,0,15,12"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="TxtUsername"
                         Grid.Row="5"
                         Grid.Column="1"
                         Height="34"
                         Margin="0,0,0,12"
                         Padding="8,5"/>


                <!-- PASSWORD -->

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Contraseña"
                           VerticalAlignment="Center"
                           Margin="0,0,15,12"
                           FontWeight="SemiBold"/>

                <PasswordBox x:Name="TxtPassword"
                             Grid.Row="6"
                             Grid.Column="1"
                             Height="34"
                             Margin="0,0,0,12"
                             Padding="8,5"/>

            </Grid>

        </ScrollViewer>


        <!-- BOTONES -->

        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Padding="15,12"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBlock x:Name="TxtConnectionStatus"
                           Text="Sin probar conexión"
                           VerticalAlignment="Center"
                           Foreground="#64748B"/>


                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Content="Cancelar"
                            Padding="18,8"
                            Margin="0,0,8,0"
                            Click="BtnCancel_Click"/>

                    <Button x:Name="BtnTestConnection"
                            Content="Probar conexión"
                            Padding="18,8"
                            Margin="0,0,8,0"
                            Click="BtnTestConnection_Click"/>

                    <Button x:Name="BtnSave"
                            Content="Guardar empresa"
                            Padding="18,8"
                            Click="BtnSave_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>
