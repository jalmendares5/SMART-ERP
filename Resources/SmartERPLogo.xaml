<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Canvas Width="800" Height="800">
        <!-- Hexagon 3D Logo -->
        <!-- Top-left blue face -->
        <Path Fill="#1976D2">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="280,150">
                        <LineSegment Point="520,150"/>
                        <LineSegment Point="520,250"/>
                        <LineSegment Point="360,350"/>
                        <LineSegment Point="280,300"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Top-right cyan face -->
        <Path Fill="#00BCD4">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="520,150">
                        <LineSegment Point="600,200"/>
                        <LineSegment Point="600,300"/>
                        <LineSegment Point="520,350"/>
                        <LineSegment Point="520,250"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Bottom-left dark blue face -->
        <Path Fill="#0D47A1">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="280,300">
                        <LineSegment Point="360,350"/>
                        <LineSegment Point="360,550"/>
                        <LineSegment Point="280,500"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Bottom-center blue face -->
        <Path Fill="#1565C0">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="360,350">
                        <LineSegment Point="520,350"/>
                        <LineSegment Point="520,550"/>
                        <LineSegment Point="360,550"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Middle-right green face (light) -->
        <Path Fill="#8BC34A">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="520,250">
                        <LineSegment Point="520,350"/>
                        <LineSegment Point="600,400"/>
                        <LineSegment Point="600,300"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Bottom-right green face (dark) -->
        <Path Fill="#4CAF50">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="520,350">
                        <LineSegment Point="520,550"/>
                        <LineSegment Point="600,500"/>
                        <LineSegment Point="600,400"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Text "Smart ERP" -->
        <TextBlock Canvas.Left="150" Canvas.Top="620" FontSize="120" FontWeight="Bold" FontFamily="Segoe UI">
            <Run Text="Smart " Foreground="#263238"/>
            <Run Text="ERP" Foreground="#1976D2"/>
        </TextBlock>
    </Canvas>
</Viewbox>
